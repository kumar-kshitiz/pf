# Copy to .env.local and fill in values
# For local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/portfolio

# For MongoDB Atlas (production):
MONGODB_URI=

# Optional HTML verification tokens (only the content value, not the whole tag).
# Set these in your hosting environment and rebuild after adding them.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
